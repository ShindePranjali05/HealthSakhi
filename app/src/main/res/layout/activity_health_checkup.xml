<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/soft_pink"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/text_health_checkup"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/health_checkups"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:gravity="center"
            android:background="@color/light_pink"
            android:layout_marginBottom="16dp" />

        <!-- Grid of Cards -->
        <GridLayout
            android:id="@+id/health_checkup_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <!-- PCOD - First Column, First Row -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pcod"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_columnWeight="1"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/pcod_checkup"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_pcod" />

            </androidx.cardview.widget.CardView>

            <!-- PCOS - Second Column, Second Row (diagonal to PCOD) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pcos"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_columnWeight="1"
                android:layout_row="1"
                android:layout_column="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/pcos_checkup"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_pcos" />

            </androidx.cardview.widget.CardView>

            <!-- Breast Cancer - Second Column, First Row -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_breast_cancer"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_columnWeight="1"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/breast_cancer_checkup"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_breast_cancer" />

            </androidx.cardview.widget.CardView>

            <!-- Cervical Cancer - First Column, Second Row -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_cervical_cancer"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_columnWeight="1"
                android:layout_row="1"
                android:layout_column="0"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cervical_cancer_checkup"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_cervical_cancer" />

            </androidx.cardview.widget.CardView>

        </GridLayout>
    </LinearLayout>
</ScrollView>
