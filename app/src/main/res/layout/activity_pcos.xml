<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PCOS">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                android:backgroundTint="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pcos_checkup"
                        android:textSize="20sp"
                        android:textColor="#FF4081"
                        android:textStyle="bold" />

                    <!-- Question 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_1_do_you_have_irregular_periods"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"/>

                    <RadioGroup
                        android:id="@+id/radioGroupIrregularPeriods"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/radioYesIrregularPeriods" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
                        <RadioButton android:id="@+id/radioNoIrregularPeriods" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no" />
                    </RadioGroup>

                    <!-- Question 2 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_2_do_you_experience_excessive_hair_growth"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"/>

                    <RadioGroup
                        android:id="@+id/radioGroupExcessiveHairGrowth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/radioYesExcessiveHairGrowth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
                        <RadioButton android:id="@+id/radioNoExcessiveHairGrowth" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no" />
                    </RadioGroup>

                    <!-- Question 3 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_3_do_you_have_difficulty_losing_weight"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"/>

                    <RadioGroup
                        android:id="@+id/radioGroupDifficultyLosingWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/radioYesDifficultyLosingWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
                        <RadioButton android:id="@+id/radioNoDifficultyLosingWeight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no" />
                    </RadioGroup>

                    <!-- Question 4 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_4_do_you_have_acne_or_oily_skin"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"/>

                    <RadioGroup
                        android:id="@+id/radioGroupAcneOilySkin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/radioYesAcneOilySkin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
                        <RadioButton android:id="@+id/radioNoAcneOilySkin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no" />
                    </RadioGroup>

                    <!-- Question 5 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/_5_do_you_have_thinning_hair_or_male_pattern_baldness"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp"/>

                    <RadioGroup
                        android:id="@+id/radioGroupThinningHair"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton android:id="@+id/radioYesThinningHair" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
                        <RadioButton android:id="@+id/radioNoThinningHair" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no" />
                    </RadioGroup>

                    <!-- Submit Button -->
                    <Button
                        android:id="@+id/btnSubmit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_result"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="#FF4081"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Result Text -->
            <TextView
                android:id="@+id/textResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textStyle="italic"
                android:textColor="#FF4081"
                android:layout_marginTop="8dp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
