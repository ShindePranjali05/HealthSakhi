<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:spacing="16dp">

        <!-- Card for Edit Profile -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:backgroundTint="@color/mint_green">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/edit_profile"
                android:textSize="18sp"
                android:textColor="@color/black" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card for Change Password -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_change_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:backgroundTint="@color/mint_green">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/change_password"
                android:textSize="18sp"
                android:textColor="@color/black" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card for Language Settings -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_language_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:backgroundTint="@color/mint_green">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/language_settings"
                android:textSize="18sp"
                android:textColor="@color/black" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card for Notifications -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:backgroundTint="@color/mint_green">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/notifications"
                android:textSize="18sp"
                android:textColor="@color/black" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card for Help and Support -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_help_support"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:backgroundTint="@color/mint_green">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/help_support"
                android:textSize="18sp"
                android:textColor="@color/black" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Card for Logout -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/light_pink">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/user_logout"
                android:textAlignment="center"
                android:textSize="18sp"
                android:textColor="@color/red" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
